# ---------------------------------------------------------------------------
# Local development environment template.
#
# Copy to `.env` (git-ignored) and adjust. NEVER commit real values.
# Every value below is a placeholder.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Shared application settings (read by the API)
# ---------------------------------------------------------------------------

# Runtime environment: local | ci | staging | production
APP_ENV=local

# Public base URL of the API (used for OpenAPI server URLs and CORS defaults)
API_BASE_URL=http://localhost:8000

# Public base URL of the web application (used for redirects and canonical URLs)
WEB_BASE_URL=http://localhost:3000

# PostgreSQL connection string.
# Compose (Docker) default:
#   postgresql://multilingua:multilingua@localhost:5432/multilingua
# Native PostgreSQL 18 default:
#   postgresql://postgres@localhost:5432/multilingua
DATABASE_URL=postgresql://multilingua:multilingua@localhost:5432/multilingua

# Secret used to derive session/CSRF key material.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# MUST be overridden in staging/production; startup fails if the placeholder
# value is used outside a local environment.
SESSION_SECRET=replace-me-with-a-48-byte-random-secret

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Log level: debug | info | warning | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Translation provider (server-only; optional)
# ---------------------------------------------------------------------------

# Translation provider adapter to use. `none` disables machine translation and
# leaves manual translation as the only path.
TRANSLATION_PROVIDER=none

# Server-only credential for the selected translation provider.
# Leave empty until a provider is configured. Never expose to the browser.
# TRANSLATION_API_KEY=

# ---------------------------------------------------------------------------
# Not enabled in Phase 0 - documented here so the names are stable.
# See docs/decisions/0006-background-jobs.md and 0008-media-storage.md.
# ---------------------------------------------------------------------------

# Shared cache / rate-limit store. Enable only when justified by metrics.
# REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage for media. Local filesystem in development.
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_REGION=

# ---------------------------------------------------------------------------
# Frontend (Next.js) public environment variables
#
# Next.js only inlines variables prefixed with NEXT_PUBLIC_. These MUST mirror
# API_BASE_URL / WEB_BASE_URL above and contain no secrets.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
